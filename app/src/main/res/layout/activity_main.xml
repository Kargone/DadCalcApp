<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="5dp"
    tools:context=".MainActivity">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/output_card"
        style="@style/DisplayCard"
        android:layout_weight="1.25">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/output_label"
                style="@style/DisplayLabel"
                android:text="@string/output_label" />

            <TextView
                android:id="@+id/output_field"
                style="@style/DisplayValue.Output"
                tools:text="5 ft 3 1/16 in" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/input_card"
        style="@style/DisplayCard"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <TextView
                style="@style/DisplayLabel"
                android:text="@string/input_label" />

            <TextView
                android:id="@+id/input_field"
                style="@style/DisplayValue.Input"
                tools:text="5 ft 3 1/16 in|" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_weight="6.5"
        android:orientation="vertical">

        <LinearLayout style="@style/KeyRow">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_left_arrow"
                style="@style/Key.Function"
                android:contentDescription="@string/move_cursor_left"
                android:text="@string/key_left_arrow" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_right_arrow"
                style="@style/Key.Function"
                android:contentDescription="@string/move_cursor_right"
                android:text="@string/key_right_arrow" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_inch_selector"
                style="@style/Key.Unit"
                android:text="@string/key_inch" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_feet_selector"
                style="@style/Key.Unit"
                android:text="@string/key_feet" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_millimeter_selector"
                style="@style/Key.Unit"
                android:text="@string/key_millimeter" />
        </LinearLayout>

        <LinearLayout style="@style/KeyRow">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_left_parenthesis"
                style="@style/Key.Function"
                android:text="@string/key_left_parenthesis" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_right_parenthesis"
                style="@style/Key.Function"
                android:text="@string/key_right_parenthesis" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_history"
                style="@style/Key.Function"
                android:text="@string/key_history" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_fraction_1"
                style="@style/Key.Fraction"
                tools:text="1/2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_multiply"
                style="@style/Key.Operator"
                android:text="@string/key_multiply" />
        </LinearLayout>

        <LinearLayout style="@style/KeyRow">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_7"
                style="@style/Key.Digit"
                android:text="@string/key_7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_8"
                style="@style/Key.Digit"
                android:text="@string/key_8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_9"
                style="@style/Key.Digit"
                android:text="@string/key_9" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_fraction_2"
                style="@style/Key.Fraction"
                tools:text="1/4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_divide"
                style="@style/Key.Operator"
                android:text="@string/key_divide" />
        </LinearLayout>

        <LinearLayout style="@style/KeyRow">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_4"
                style="@style/Key.Digit"
                android:text="@string/key_4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_5"
                style="@style/Key.Digit"
                android:text="@string/key_5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_6"
                style="@style/Key.Digit"
                android:text="@string/key_6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_fraction_3"
                style="@style/Key.Fraction"
                tools:text="1/8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_add"
                style="@style/Key.Operator"
                android:text="@string/key_add" />
        </LinearLayout>

        <LinearLayout style="@style/KeyRow">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_1"
                style="@style/Key.Digit"
                android:text="@string/key_1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_2"
                style="@style/Key.Digit"
                android:text="@string/key_2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_3"
                style="@style/Key.Digit"
                android:text="@string/key_3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_fraction"
                style="@style/Key.Function"
                android:text="@string/key_fraction" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_subtract"
                style="@style/Key.Operator"
                android:text="@string/key_subtract" />
        </LinearLayout>

        <LinearLayout style="@style/KeyRow">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_0"
                style="@style/Key.Digit"
                android:text="@string/key_0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_decimal"
                style="@style/Key.Digit"
                android:text="@string/key_decimal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_delete"
                style="@style/Key.Function"
                android:contentDescription="@string/delete_description"
                android:text="@string/key_delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_round"
                style="@style/Key.Function"
                android:maxLines="2"
                android:text="@string/key_round" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_equal"
                style="@style/Key.Equals"
                android:text="@string/key_equal" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
