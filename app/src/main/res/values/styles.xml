<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DisplayCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardBackgroundColor">@color/display_background</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/display_stroke</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="DisplayLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/display_label</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="DisplayValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:textColor">@color/display_text</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">14sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <style name="DisplayValue.Output">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeMaxTextSize">54sp</item>
    </style>

    <style name="DisplayValue.Input">
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">start</item>
        <item name="autoSizeMaxTextSize">30sp</item>
    </style>

    <style name="KeyRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Keys stretch to fill their share of the keypad; only a 3dp gap separates them -->
    <style name="Key" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">9sp</item>
        <item name="autoSizeMaxTextSize">24sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/key_ripple</item>
        <item name="backgroundTint">@color/key_digit</item>
        <item name="android:textColor">@color/key_digit_text</item>
    </style>

    <style name="Key.Digit">
        <item name="autoSizeMaxTextSize">34sp</item>
    </style>

    <style name="Key.Function">
        <item name="backgroundTint">@color/key_function_background</item>
        <item name="android:textColor">@color/key_function_foreground</item>
    </style>

    <style name="Key.Unit">
        <item name="autoSizeMaxTextSize">28sp</item>
        <item name="backgroundTint">@color/key_unit_background</item>
        <item name="android:textColor">@color/key_unit_foreground</item>
    </style>

    <style name="Key.Fraction">
        <item name="autoSizeMaxTextSize">28sp</item>
        <item name="backgroundTint">@color/key_fraction_background</item>
        <item name="android:textColor">@color/key_fraction_foreground</item>
    </style>

    <style name="Key.Operator">
        <item name="autoSizeMaxTextSize">36sp</item>
        <item name="backgroundTint">@color/key_operator</item>
        <item name="android:textColor">@color/key_operator_text</item>
    </style>

    <style name="Key.Equals">
        <item name="autoSizeMaxTextSize">36sp</item>
        <item name="backgroundTint">@color/key_equals</item>
        <item name="android:textColor">@color/key_equals_text</item>
    </style>
</resources>
