<?xml version="1.0" encoding="utf-8"?>
<!-- A tape measure. Drawn on a 108dp grid. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Scaled down so the whole drawing fits in the round 66dp safe zone -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateY="2">
        <!-- Tape, coming out of the bottom of the case -->
        <path
            android:fillColor="#FFF5E2B8"
            android:pathData="M56,63h26v11h-26z" />
        <!-- Tick marks, long every inch and short in between -->
        <path
            android:fillColor="#FF1B1B1B"
            android:pathData="M66.5,63h1.6v3.5h-1.6z M71,63h1.6v6h-1.6z M75.5,63h1.6v3.5h-1.6z" />
        <!-- Hook on the end of the tape -->
        <path
            android:fillColor="#FF1B1B1B"
            android:pathData="M80,58h5v19h-5z" />
        <!-- Case -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M36,28h16a13,13 0,0 1,13 13v20a13,13 0,0 1,-13 13h-16a13,13 0,0 1,-13 -13v-20a13,13 0,0 1,13 -13z" />
        <!-- Lock button on top of the case -->
        <path
            android:fillColor="#FF1B1B1B"
            android:pathData="M38,24h12a2,2 0,0 1,2 2v2h-16v-2a2,2 0,0 1,2 -2z" />
        <!-- Hub -->
        <path
            android:fillColor="#FFCF6A1A"
            android:pathData="M44,40a11,11 0,1 1,0 22a11,11 0,1 1,0 -22z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M44,47a4,4 0,1 1,0 8a4,4 0,1 1,0 -8z" />
    </group>
</vector>
